# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Neon connection string (pooled)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Password for /admin
ADMIN_PASSWORD=change-me
# Random 32+ char string used to sign admin sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
